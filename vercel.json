{
  "alias": ["letterbrick.vercel.app"],
  "functions": {
    "api/score.js":   { "maxDuration": 30 },
    "api/emotion.js": { "maxDuration": 20 },
    "api/ocr.js":     { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" }
      ]
    }
  ]
}
